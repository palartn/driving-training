# قالب إعدادات الإنتاج. انسخه إلى .env على الخادم وعدّل القيم، ولا تضع .env داخل مجلد الويب العام ولا في Git.
APP_NAME="نظام إدارة قسم السياقة"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://CHANGE-ME.example

APP_LOCALE=ar
APP_FALLBACK_LOCALE=ar

LOG_CHANNEL=daily
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=driving
DB_USERNAME=CHANGE_ME
DB_PASSWORD=CHANGE_ME

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax

CACHE_STORE=database
QUEUE_CONNECTION=sync
BCRYPT_ROUNDS=12

CURRENCY_SYMBOL=₪
UNPAID_SUBJECTS_BLOCK_THRESHOLD=2

# النسخ الاحتياطي
BACKUP_DIRECTORY=
BACKUP_RETENTION_DAYS=30
BACKUP_TIME=02:00
# مثال Windows: C:\Program Files\MySQL\MySQL Server 8.4\bin\mysqldump.exe
MYSQLDUMP_PATH=mysqldump
MYSQL_CLIENT_PATH=mysql
